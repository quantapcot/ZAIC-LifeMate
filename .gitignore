# Dữ liệu do Ban tổ chức cung cấp: giữ local, tuyệt đối không commit
/train/*
!/train/.gitkeep
/public_test/*
!/public_test/.gitkeep

# Model tải về và checkpoint sinh ra khi train
/models/pretrained/*
!/models/pretrained/.gitkeep
/models/checkpoints/*
!/models/checkpoints/.gitkeep

# Transcript, session và submission tạm sinh ra khi chạy pipeline
/outputs/*
!/outputs/benchmarks/

# Model weights and submissions
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.bin
/submission*
/submissions/

# Python environments and caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store

# Local secrets
.env
.env.*
!.env.example
